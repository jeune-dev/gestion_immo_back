# ============================================================================
#  Gestion Immo API — variables d'environnement
#  Copier en .env (JAMAIS versionné). Valeurs entre guillemets si elles
#  contiennent « # » ou des espaces (dotenv coupe au « # » sinon).
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Bare-metal derrière nginx : 127.0.0.1. En Docker : forcé à 0.0.0.0 par compose.
HOST=127.0.0.1
APP_NAME="Gestion Immo"
APP_TIMEZONE=Africa/Dakar
DEFAULT_COUNTRY_CODE=221
# URL publique de l'API (webhooks PayDunya/Wave, liens) et de l'application web.
API_PUBLIC_URL=https://api.exemple.sn
APP_PUBLIC_URL=https://app.exemple.sn
# Origines autorisées (web super admin), séparées par des virgules. « * » interdit en production.
CORS_ORIGIN=https://admin.exemple.sn
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
LOG_DIR=./logs

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gestion_imo
DB_USER=gestion_imo
DB_PASSWORD=
# Rôle APPLICATIF (privilèges minimaux, créé au démarrage par src/scripts/rolesBase.js)
# ci-dessus ; PROPRIÉTAIRE du schéma ci-dessous, utilisé UNIQUEMENT pour les
# migrations au démarrage (Docker : superutilisateur créé par l'image postgres).
# Mot de passe du rôle applicatif : 16 caractères minimum.
DB_ADMIN_USER=gestion_imo_proprietaire
DB_ADMIN_PASSWORD=
# Certificat CA (PEM ou base64) si la base est distante et exige TLS ; vide sinon.
DB_SSL_CA=
# Pool PAR worker PM2 : DB_POOL_MAX × workers < max_connections − 10.
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# ── Secrets (générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
JWT_REFRESH_SECRET=
INVITATION_SECRET=
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENC_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Durée MAXIMALE absolue d'une session, rotations comprises (super admin : en heures).
SESSION_DUREE_MAX_JOURS=90
SESSION_DUREE_MAX_HEURES_ADMIN=12
MAX_SESSIONS_PAR_UTILISATEUR=10
BCRYPT_ROUNDS=12
LOGIN_MAX_TENTATIVES=5
LOGIN_BLOCAGE_MINUTES=15

# ── Super admin initial (créé au premier démarrage, mot de passe à changer) ──
# 12 caractères minimum, majuscule, minuscule, chiffre, caractère spécial.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# ── Limites de débit ─────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_UTILISATEUR_MAX=600
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
SESSION_RATE_LIMIT_MAX=120
MUTATION_RATE_LIMIT_MAX=30
PAIEMENT_RATE_LIMIT_MAX=30
OTP_CIBLE_RATE_LIMIT_MAX=3
WEBHOOK_RATE_LIMIT_MAX=300
ADMIN_RATE_LIMIT_MAX=600
# Redis : compteurs partagés entre workers PM2 + cache (fortement recommandé en production).
REDIS_URL=redis://127.0.0.1:6379
# Mot de passe Redis (OBLIGATOIRE avec docker-compose.prod.yml, qui construit
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379). Caractères sûrs pour une URL
# uniquement : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASSWORD=

# ── Stockage objet Cloudflare R2 (vide = disque local, développement) ────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
UPLOAD_DIR=./uploads
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=15
UPLOAD_MAX_VIDEO_MB=60
# Mémoire maximale des téléversements EN COURS par processus (Mo), envois
# simultanés par utilisateur, envois par utilisateur par 15 min.
UPLOAD_MEMOIRE_MAX_MO=150
UPLOAD_SIMULTANES_PAR_UTILISATEUR=2
UPLOAD_RATE_LIMIT_MAX=60
# Rapports / exports / PDF générés à la volée par utilisateur par 15 min ; lignes max d'un export CSV.
RAPPORT_RATE_LIMIT_MAX=60
EXPORT_MAX_LIGNES=10000

# ── Sauvegardes (deploy/backup-postgres.sh — voir docs/EXPLOITATION.md) ──────
# Ce fichier est LU (jamais exécuté) par les scripts de sauvegarde.
# Clé(s) PUBLIQUE(S) age « age1… » (virgules entre plusieurs clés) ou chemin
# absolu d'un fichier de destinataires. La clé privée n'est JAMAIS sur le serveur.
BACKUP_AGE_RECIPIENT=
# Destination rclone hors site (bucket R2/S3 avec versionnage + Object Lock),
# ex. r2-sauvegardes:gestion-imo-backups/prod
BACKUP_RCLONE_REMOTE=
BACKUP_DIR=./backups
# Rétention LOCALE en jours (la rétention distante = règle de cycle de vie du bucket).
RETENTION_JOURS=14
# Développement UNIQUEMENT : autoriser une sauvegarde en clair / sans copie hors site.
# BACKUP_ALLOW_PLAINTEXT=1
# BACKUP_ALLOW_LOCAL_ONLY=1
# Rôle PostgreSQL des sauvegardes/restaurations s'il diffère de DB_USER
# (ex. rôle propriétaire quand DB_USER est un rôle applicatif restreint).
# BACKUP_DB_USER=
# BACKUP_DB_PASSWORD=
# Vérifier la copie distante par relecture complète (plus lent).
# BACKUP_RCLONE_CHECK_DOWNLOAD=1

# ── E-mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Gestion Immo <no-reply@exemple.sn>"

# ── Notifications push FCM (JSON du compte de service, brut ou base64) ───────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── WhatsApp Business Cloud API (§ 54) ───────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── PayDunya PLATEFORME (paiement des abonnements SaaS, § 31) ────────────────
# Clés de l'application PayDunya Business de la plateforme (dashboard PayDunya →
# « Intégrez notre API » → détails de l'application). Les loyers utilisent les
# clés PROPRES à chaque propriétaire (§ 51.5), saisies dans l'application et
# chiffrées en base. PAYDUNYA_MODE : test (sandbox) ou live.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=live
# Préproduction UNIQUEMENT : autoriser le bac à sable PayDunya avec NODE_ENV=production
# (interdit par défaut : un paiement de test ne doit jamais solder un vrai loyer).
# PAIEMENT_MODE_TEST_AUTORISE=1
# Nom affiché sur la page de paiement des abonnements.
PAYDUNYA_STORE_NAME=Gestion immobilière
# PAYDUNYA_TIMEOUT_MS=20000

# ── Supervision ──────────────────────────────────────────────────────────────
# Jeton exigé par GET /metrics (sans jeton, la route n'existe pas).
METRICS_TOKEN=
# Alertes d'exploitation (OBLIGATOIRE en production : au moins un canal).
# Webhook JSON (Slack, Mattermost, Discord, Teams…) et/ou e-mails (séparés par des virgules).
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
# Une alerte d'un même type au plus toutes les N minutes ; seuils de rafale par minute.
ALERTE_ANTI_REPETITION_MIN=15
ALERTE_SEUIL_5XX_MINUTE=20
ALERTE_SEUIL_LIMITES_MINUTE=200
# Désactiver les tâches planifiées sur une instance secondaire (hors PM2 cluster).
JOBS_ENABLED=true
