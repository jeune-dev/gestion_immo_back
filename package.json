{
  "name": "gestion-imo-api",
  "version": "1.0.0",
  "description": "SaaS de gestion immobilière — backend API Node.js/Express/PostgreSQL",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "seed": "sequelize-cli db:seed:all",
    "init": "node src/scripts/initialiser.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production --update-env",
    "pm2:stop": "pm2 stop gestion-imo-api",
    "pm2:logs": "pm2 logs gestion-imo-api",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f backend",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "backup": "bash deploy/backup-postgres.sh",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "doc:routes": "node scripts/lister-routes.js",
    "test:watch": "jest --watch --selectProjects unit integration",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --selectProjects e2e",
    "test:serie": "jest --runInBand",
    "test:ordre-aleatoire": "jest --randomize",
    "test:routes": "node scripts/couverture-routes.js",
    "secrets:generer": "node scripts/generer-secrets.js",
    "test:performance": "jest --runTestsByPath src/__tests__/integration/performance/n-plus-un.test.js src/__tests__/integration/performance/horizon-echeances.test.js",
    "perf:peupler": "node scripts/perf/peupler.js",
    "perf:amplifier": "node scripts/perf/amplifier.js",
    "perf:audit": "node scripts/perf/audit-sql.js",
    "perf:charge": "node scripts/perf/charge.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.32.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
